# Workshop Agent 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env.local
#   .env.local 파일을 열고 실제 값을 입력하세요.
#   .env.local은 .gitignore에 포함되어 있어 커밋되지 않습니다.

# ══════════════════════════════════════════════
# 1. Supabase — 공개 키 (클라이언트 접근 가능)
# ══════════════════════════════════════════════
#
# [로컬 개발] npx supabase start 실행 후 터미널 출력값을 복사하세요:
#   API URL:   http://127.0.0.1:54321
#   anon key:  eyJhbG... (출력에서 복사)
#   service_role key: eyJhbG... (출력에서 복사)
#
# [리모트 Supabase] 대시보드 → Settings → API 에서 가져오세요:
#   https://supabase.com/dashboard/project/<project-id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: newer Supabase publishable key alias. If set, browser clients prefer this.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ══════════════════════════════════════════════
# 2. Supabase — 서버 전용 키 (절대 NEXT_PUBLIC_ 접두사 금지)
# ══════════════════════════════════════════════

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ══════════════════════════════════════════════
# 3. 세션 시크릿 (참석자 쿠키 서명용, 32자 이상)
# ══════════════════════════════════════════════
# 생성 방법: openssl rand -base64 32
# SUPABASE_SERVICE_ROLE_KEY와 반드시 다른 값을 사용할 것

SESSION_SECRET=your-random-secret-at-least-32-chars

# ══════════════════════════════════════════════
# 4. Azure OpenAI (AI 클러스터링, 설계, PRD, 보고서 생성)
# ══════════════════════════════════════════════
# Azure Portal → OpenAI 리소스 → Keys and Endpoint 에서 가져오세요.
# 로컬에서도 실제 Azure OpenAI 키가 필요합니다 (mock 미지원).

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
