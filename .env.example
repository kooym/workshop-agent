# Workshop Agent 환경 변수 템플릿
#
# ╔══════════════════════════════════════════════════════════╗
# ║ 로컬 개발 (Docker Compose)                               ║
# ║   1. docker/.env 에서 AZURE_OPENAI_API_KEY 입력          ║
# ║   2. docker compose up -d                                ║
# ║   → 환경변수는 docker-compose.yml이 자동 주입합니다.       ║
# ║   → 이 파일(.env.local)은 docker compose 환경에서 불필요. ║
# ╠══════════════════════════════════════════════════════════╣
# ║ 호스트 직접 실행 (npm run dev)                            ║
# ║   1. cp .env.example .env.local                          ║
# ║   2. .env.local에 실제 값 입력                            ║
# ║   3. 별도 Supabase 인스턴스 필요                          ║
# ╠══════════════════════════════════════════════════════════╣
# ║ Azure 프로덕션 배포                                       ║
# ║   - NEXT_PUBLIC_SUPABASE_URL → Supabase Cloud URL        ║
# ║   - 나머지 시크릿은 Azure App Service 환경변수에 설정      ║
# ╚══════════════════════════════════════════════════════════╝

# ══════════════════════════════════════════════
# 1. Supabase — 공개 키 (클라이언트 접근 가능)
# ══════════════════════════════════════════════
#
# [Docker Compose] docker compose가 자동 주입 (변경 불필요)
# [호스트 직접 실행] 외부 Supabase URL과 anon key 입력
# [Azure 프로덕션] Supabase Cloud URL과 anon key 입력

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ══════════════════════════════════════════════
# 2. Supabase — 서버 전용 키 (절대 NEXT_PUBLIC_ 접두사 금지)
# ══════════════════════════════════════════════

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ══════════════════════════════════════════════
# 3. 세션 시크릿 (참석자 쿠키 서명용, 32자 이상)
# ══════════════════════════════════════════════
# 생성 방법: openssl rand -base64 32
# SUPABASE_SERVICE_ROLE_KEY와 반드시 다른 값을 사용할 것

SESSION_SECRET=your-random-secret-at-least-32-chars

# ══════════════════════════════════════════════
# 4. Azure OpenAI (AI 클러스터링, 설계, PRD, 보고서 생성)
# ══════════════════════════════════════════════
# Azure Portal → OpenAI 리소스 → Keys and Endpoint 에서 가져오세요.
# 로컬에서도 실제 Azure OpenAI 키가 필요합니다 (mock 미지원).

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
